ADMIN_MODE=true

# GCP Deployment Variables
GCP_PROJECT_ID=your_project_id
GCP_PROJECT_NUMBER=your_project_number
GCP_SERVICE_NAME=music-library
GCP_REGION=us-central1
GCP_DATA_BUCKET_NAME=your_data_bucket_name

# Deezer playlist mirror (optional, used by the sync button)
# App from developers.deezer.com/myapps, with redirect URL
# http://localhost:8000/api/deezer/callback. Open /api/deezer/login once to
# connect; that saves DEEZER_ACCESS_TOKEN here.
DEEZER_APP_ID=
DEEZER_APP_SECRET=
DEEZER_PLAYLIST_ID=
